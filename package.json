{
  "name": "assetkit",
  "private": true,
  "version": "0.1.0",
  "description": "Shared static assets (plants, trees, rocks, statues, textures) for many projects: the generators that make them and their assetmgr indexes.",
  "type": "module",
  "scripts": {
    "assets": "node ${ASSETMGR_DIR:-../assetmgr}/dist/cli.js restore",
    "import:statues": "node tools/import-statues.ts",
    "models": "node tools/modelpack/pack.ts && node tools/modelpack/status.ts",
    "models:status": "node tools/modelpack/status.ts",
    "trees": "blender -b -P tools/deciduousgen/gen.py --",
    "trees:textures": "python3 tools/deciduousgen/fetch.py && python3 tools/deciduousgen/pages.py",
    "conifers": "blender -b -P tools/conifergen/gen.py --",
    "conifers:textures": "python3 tools/conifergen/fetch.py && python3 tools/conifergen/pages.py",
    "rocks": "blender -b -P tools/rockgen/gen.py --",
    "rocks:textures": "python3 tools/rockgen/fetch.py",
    "plants": "blender -b -P tools/plantgen/gen.py --",
    "bushes": "blender -b -P tools/bushgen/gen.py --",
    "plants:textures": "python3 tools/plantgen/fetch.py && python3 tools/plantgen/paint.py && python3 tools/plantgen/pages.py",
    "import:nature": "node tools/import-nature.ts",
    "import:sources": "node tools/import-sources.ts",
    "assets:upload": "npm run import:nature && npm run import:sources && npm run import:statues && node ${ASSETMGR_DIR:-../assetmgr}/dist/cli.js upload",
    "postinstall": "node tools/link-siblings.mjs assetmgr=ASSETMGR_DIR:../assetmgr"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.4"
  }
}
